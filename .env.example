# Local-only default: leave DATABASE_URL unset to use embedded PGlite.
# Shared/staging/production deployments should use reviewed Drizzle migrations.
# DATABASE_URL=postgresql://planner:password@127.0.0.1:5432/nyush_planner
PGLITE_DIR=.pglite

AUTH_SECRET=replace-with-a-long-random-secret
AUTH_TRUST_HOST=true
ADMIN_EMAILS=maintainer@example.nyu.edu

# Optional production OAuth providers. Only @nyu.edu identities are accepted.
# AUTH_MICROSOFT_ENTRA_ID_ID=replace-me
# AUTH_MICROSOFT_ENTRA_ID_SECRET=replace-me
# AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/replace-me/v2.0
# AUTH_GOOGLE_ID=replace-me
# AUTH_GOOGLE_SECRET=replace-me

# Disposable release verification only. Never point these at production.
# PGLITE_DIR=.pglite-staging
# ALLOW_DESTRUCTIVE_MIGRATION_REHEARSAL=true
# MIGRATION_REHEARSAL_TARGET=pglite://memory/v0-2-rehearsal
# PRODUCTION_DATABASE_URL=postgresql://production-placeholder/never-use

# Optional legacy admin authoring utility.
# DEEPSEEK_API_KEY=replace-me
